{
  "name": "@longlonga/mysql",
  "version": "1.0.5",
  "description": "MCP server for MySQL database interaction",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mysql": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
